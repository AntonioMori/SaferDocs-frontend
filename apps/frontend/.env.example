# Copie para `.env` e ajuste. O `.env` não vai para o git (RNF-07).
# Variáveis VITE_* ficam visíveis no navegador: não ponha segredo aqui.

# Prefixo da API, relativo à origem do front. Obrigatória.
# Mudar só se o backend mudar de versão (/api/v2).
VITE_API_BASE_URL=/api/v1

# Backend que recebe o proxy de /api no Vite (dev e preview).
# Não entra no bundle. Em produção o nginx faz esse papel.
VITE_SERVER_URL=http://localhost:8000

# Pasta base dos assets estáticos (vazio = raiz do site). Opcional.
VITE_ASSETS_DIR=
